# Copia este archivo a .env.local y rellena lo que tengas. Todo es opcional.
# Solo se aceptan URLs https:// (cualquier otra cosa se ignora).

# Dominio público del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://cobroneto.mx

# Enlaces de afiliado (si están vacíos se usan los sitios oficiales sin rel="sponsored")
NEXT_PUBLIC_AFF_WISE=
NEXT_PUBLIC_AFF_PAYONEER=

# Formulario o WhatsApp para canalizar leads a contadores (si está vacío, el bloque no aparece)
NEXT_PUBLIC_LEAD_URL=
